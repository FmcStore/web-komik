{
  "rewrites": [
    {
      "source": "/series/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/chapter/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/((?!404\\.html|assets/|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
